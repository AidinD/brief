{
  "name": "brief",
  "version": "0.1.17",
  "description": "The morning surface: what the world did that you can act on, what your week was, and the few things that want confirming",
  "author": "Aidin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/AidinD/brief.git"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p jsconfig.renderer.json",
    "dev": "electron .",
    "test:app": "node scripts/e2e-app.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "sample": "node scripts/write-sample.mjs",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "plan": "node scripts/plan.mjs",
    "morning": "node scripts/morning.mjs",
    "schedule": "node scripts/schedule.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "keel": "file:../keel"
  },
  "main": "src/main/index.js"
}
